@model HorseBase.Models.ViewModels.ReservationViewModel

@{
    ViewData["Title"] = "Create Reservation";
}

<style>
    /* Consistent container styling */
    .container {
        background: rgba(230, 200, 160);
        border-radius: 15px;
        padding: 1.5rem;
        max-width: 500px;
        margin: 2rem auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        max-height: 85vh; /* Enable vertical scrolling */
        overflow-y: auto; /* Add vertical scrollbar when needed */
        scrollbar-color: #8ea7e9 #f8f9fa; /* Custom scrollbar colors */
        scrollbar-width: thin; /* Thin scrollbar for modern browsers */
        position: relative;
        z-index: 2;
    }

        /* Scrollbar styling for Webkit browsers */
        .container::-webkit-scrollbar {
            width: 8px;
        }

        .container::-webkit-scrollbar-track {
            background: #f8f9fa;
            border-radius: 10px;
        }

        .container::-webkit-scrollbar-thumb {
            background: #8ea7e9;
            border-radius: 10px;
        }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }

    /* Form group styling */
    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            text-align: center;
            font-size: 18px;
            color: #343a40;
        }

    .form-control {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        padding: 0.6rem 1rem;
        color: #343a40;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2);
            outline: none;
        }

    /* Primary button styling */
    .btn-primary {
        background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
        width: 100%;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }

    /* Read-only input styling */
    .form-control[readonly] {
        background: rgba(255, 255, 255, 0.1);
        cursor: not-allowed;
        color: #6c757d;
    }

    /* Error message styling */
    .error-message {
        background: rgba(255, 0, 0, 0.1); /* Light red background */
        color: #dc3545; /* Red text color */
        padding: 0.6rem 1rem; /* Padding for spacing */
        border-radius: 8px; /* Rounded corners */
        margin-bottom: 1rem; /* Space below the error message */
        font-size: 14px; /* Smaller font size */
        text-align: center; /* Center-aligned text */
        border: 1px solid rgba(255, 0, 0, 0.3); /* Subtle red border */
        box-shadow: 0 2px 5px rgba(255, 0, 0, 0.1); /* Soft shadow for depth */
        display: none; /* Hidden by default */
        transition: opacity 0.3s ease; /* Smooth fade-in effect */
    }

        /* Force visibility when display is set to block */
        .error-message[style*="display: block"] {
            opacity: 1 !important;
        }

    /* Style for the disabled button */
    .btn-disabled {
        background: linear-gradient(135deg, rgba(190, 190, 190, 0.8), rgba(220, 220, 220, 0.8)) !important; /* Grayed-out gradient */
        border: none;
        cursor: not-allowed; /* Change cursor to indicate it's disabled */
        box-shadow: none !important; /* Remove shadow */
        transform: none !important; /* Remove hover effects */
        color: #a0a0a0 !important; /* Light gray text */
    }

        /* Hover effect for disabled button */
        .btn-disabled:hover {
            background: linear-gradient(135deg, rgba(190, 190, 190, 0.9), rgba(220, 220, 220, 0.9)) !important;
            transform: none !important; /* No animation */
        }
</style>

<div class="container">
    <h1 class="big-title">Резервирай</h1>

    <!-- Error message container -->
    <div id="dateError" class="error-message">
        Датата и час на връщане трябва да е след датата и часа на взимане!
    </div>

    <form asp-action="Create" method="post" class="d-flex flex-column" id="reservationForm">
        <div class="form-group">
            <label asp-for="TakeHour" class="control-label"></label>
            <input asp-for="TakeHour" class="form-control" type="datetime-local" />
            <span asp-validation-for="TakeHour" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ReturnHour" class="control-label"></label>
            <input asp-for="ReturnHour" class="form-control" type="datetime-local" />
            <span asp-validation-for="ReturnHour" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price" class="control-label">Цена</label>
            <input id="displayPrice" class="form-control" readonly />
            <input asp-for="Price" type="text" id="submitPrice" hidden />
        </div>

        <input type="hidden" asp-for="HorseId" />

        <!-- Submit Button -->
        <div class="form-group">
            <button type="submit" class="btn btn-primary" id="submitButton">Резервирай</button>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const horsePricePerHour = parseFloat(@Html.Raw(Json.Serialize(Model.Horse?.Price ?? 0))) || 0;

        const takeHourInput = document.querySelector("#TakeHour");
        const returnHourInput = document.querySelector("#ReturnHour");
        const displayPriceInput = document.querySelector("#displayPrice");
        const submitPriceInput = document.querySelector("#submitPrice");
        const dateError = document.querySelector("#dateError");
        const reservationForm = document.querySelector("#reservationForm");
        const submitButton = document.querySelector("#submitButton");
        let showError = false;

        let isValidDateRange = true; // Track if the date range is valid
        let hasOverlap = false; // Track if there is an overlap

        // Function to calculate price and validate date range
        function calculatePrice() {
            const takeHour = new Date(takeHourInput.value);
            const returnHour = new Date(returnHourInput.value);

            if (takeHour && returnHour) {
                if (returnHour > takeHour) {
                    // Valid date range
                    const hours = Math.abs(returnHour - takeHour) / 36e5; // Convert milliseconds to hours
                    const totalPrice = parseFloat((horsePricePerHour * hours).toFixed(2)); // Ensure it's a number
                    displayPriceInput.value = totalPrice.toFixed(2); // Update the visible price
                    submitPriceInput.value = totalPrice.toFixed(2); // Update the hidden price for submission
                    dateError.style.display = "none"; // Hide the error message
                    isValidDateRange = true; // Mark as valid
                    console.log("Valid date range. Hiding error message.");
                } else {
                    // Invalid date range
                    showError = true;
                    displayPriceInput.value = "0.00";
                    submitPriceInput.value = "0.00";
                    dateError.textContent = "Датата и час на връщане трябва да е след датата и часа на взимане!";
                    dateError.style.display = "block"; // Show the error message
                    isValidDateRange = false; // Mark as invalid
                    console.log("Invalid date range. Showing error message.");
                }
            } else {
                // No dates selected
                displayPriceInput.value = "0.00";
                submitPriceInput.value = "0.00";
                dateError.style.display = "none"; // Hide the error message
                isValidDateRange = false; // Mark as invalid
                console.log("No dates selected. Hiding error message.");
            }

            updateSubmitButtonState(); // Update button state
        }

        // Function to check for overlapping reservations
        async function checkForOverlaps() {
            const takeHour = takeHourInput.value;
            const returnHour = returnHourInput.value;
            const horseId = @Model.HorseId;

            if (takeHour && returnHour) {
                try {
                    const response = await fetch(`/Reservation/CheckOverlaps?horseId=${horseId}&takeHour=${takeHour}&returnHour=${returnHour}`);
                    const data = await response.json();

                    if (data.isOverlapping) {
                        dateError.textContent = "Конят е вече резервиран за зададените дата и час. Моля изберете различна дата и час";
                        dateError.style.display = "block";
                        hasOverlap = true; // Mark as overlapping
                        console.log("Overlap detected. Showing error message.");
                    } else {
                        if(!showError){
                            dateError.style.display = "none";
                            console.log("No overlap detected. Hiding error message.");
                        }
                        hasOverlap = false; // No overlap
                    }
                } catch (error) {
                    console.error("Error checking for overlaps:", error);
                    dateError.textContent = "An error occurred while checking for overlaps. Please try again later.";
                    dateError.style.display = "block";
                    hasOverlap = true; // Mark as overlapping to disable the button
                }
            } else {
                hasOverlap = false; // No input means no overlap
                if(!showError){
                    dateError.style.display = "none";
                    console.log("No input. Hiding error message.");
                }
            }

            updateSubmitButtonState(); // Update button state
        }

        // Function to update the submit button state
        function updateSubmitButtonState() {
            const isFormValid = isValidDateRange && !hasOverlap;

            // Enable or disable the button
            submitButton.disabled = !isFormValid;

            // Apply styles based on the button state
            if (!isFormValid) {
                submitButton.classList.add("btn-disabled"); // Add disabled style
            } else {
                submitButton.classList.remove("btn-disabled"); // Remove disabled style
            }
        }

        // Attach event listeners
        takeHourInput.addEventListener("change", () => {
            calculatePrice();
            checkForOverlaps();
        });

        returnHourInput.addEventListener("change", () => {
            calculatePrice();
            checkForOverlaps();
        });

        // Initialize button state on page load
        updateSubmitButtonState();

        // Prevent form submission if validation fails
        reservationForm.addEventListener("submit", function (event) {
            console.log("Form submission triggered.");

            // Recalculate price to ensure validation is up-to-date
            calculatePrice();

            // Check for overlaps
            checkForOverlaps();

            // Wait for overlap check to complete
            setTimeout(() => {
                if (!isValidDateRange || hasOverlap) {
                    event.preventDefault(); // Prevent form submission
                    dateError.style.display = "block"; // Show the error message
                    console.log("Form submission blocked due to validation errors.");
                } else {
                    console.log("Form submission allowed.");
                }
            }, 100); // Delay to allow overlap check to complete
        });
    });
</script>