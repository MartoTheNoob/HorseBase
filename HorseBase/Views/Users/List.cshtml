@model List<HorseBase.Models.ViewModels.User.UserViewModel>

@{
	ViewData["Title"] = "User List";
}

<style>
	/* Base page styling */
	body {
		background: linear-gradient(135deg, #f8f9fa, #e9ecef);
		min-height: 100vh;
		font-family: 'Inter', sans-serif;
	}

	.big-title {
		text-align: center;
		margin-bottom: 1.5rem;
		color: #343a40;
	}

	/* Container styling */
	.container {
		background: rgb(230, 200, 160);
		border-radius: 15px;
		padding: 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
		position: relative;
		z-index: 2;
	}

	/* Back button styling */
	.back-button {
		position: absolute;
		top: 1rem;
		left: 1rem;
		background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
		border: none;
		padding: 0.6rem 1.5rem;
		border-radius: 25px;
		font-weight: 600;
		color: #fff;
		text-decoration: none;
		transition: all 0.3s ease;
		box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
		cursor: pointer;
	}

		.back-button:hover {
			background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
			transform: translateY(-2px);
			box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
		}

	/* Search bar styling */
	.search-bar {
		margin-bottom: 1.5rem;
		text-align: center;
	}

		.search-bar input[type="text"] {
			background: rgba(255, 255, 255, 0.2);
			border: 1px solid rgba(255, 255, 255, 0.3);
			border-radius: 8px;
			padding: 0.6rem 1rem;
			color: #343a40;
			width: 100%;
			max-width: 400px;
			transition: all 0.3s ease;
		}

			.search-bar input[type="text"]:focus {
				background: rgba(255, 255, 255, 0.3);
				border-color: #8ea7e9;
				outline: none;
			}

	/* Table styling */
	.table {
		width: 100%;
		border-collapse: collapse;
		margin-top: 1rem;
		background: rgba(255, 255, 255, 0.15);
		border-radius: 10px;
		overflow: hidden;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
	}

		.table th,
		.table td {
			padding: 0.8rem 1rem;
			text-align: center;
			border: none;
		}

		.table thead {
			background: rgba(255, 255, 255, 0.2);
			color: #343a40;
			font-weight: bold;
		}

		.table tbody tr {
			position: relative;
			border-bottom: 1px solid rgba(0, 0, 0, 0.1);
			transition: all 0.3s ease;
		}

			.table tbody tr:last-child {
				border-bottom: none;
			}

			.table tbody tr:hover {
				background: rgba(255, 255, 255, 0.1);
				border-color: rgba(142, 167, 233, 0.3);
			}

			.table tbody tr:nth-child(even) {
				background: rgba(255, 255, 255, 0.05);
			}

	/* Pagination styling */
	.pagination {
		display: flex;
		justify-content: center;
		margin-top: 1rem;
		gap: 0.5rem;
	}

		.pagination button {
			background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
			border: none;
			padding: 0.5rem 1rem;
			border-radius: 15px;
			font-weight: 600;
			transition: all 0.3s ease;
			box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
			cursor: pointer;
		}

			.pagination button:hover {
				background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
				transform: translateY(-2px);
				box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
			}

			.pagination button.active {
				background: linear-gradient(135deg, rgba(142, 167, 233, 1), rgba(187, 209, 253, 1));
				font-weight: bold;
			}

	/* Form controls */
	.form-group {
		margin-top: 1rem;
		text-align: center;
	}

	.form-select {
		background: rgba(255, 255, 255, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 8px;
		padding: 0.6rem 1rem;
		color: #343a40;
		width: 120px;
		transition: all 0.3s ease;
	}

		.form-select:focus {
			background: rgba(255, 255, 255, 0.3);
			border-color: #8ea7e9;
			outline: none;
		}

	/* Buttons */
	.btn-primary {
		background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
		border: none;
		padding: 0.6rem 1.5rem;
		border-radius: 15px;
		font-weight: 600;
		color: #fff;
		transition: all 0.3s ease;
		box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
		cursor: pointer;
		width: 100%;
	}

		.btn-primary:hover {
			background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
			transform: translateY(-2px);
			box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
		}

	.search-bar button[type="submit"] {
		background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
		border: none;
		padding: 0.6rem 1.5rem;
		border-radius: 15px;
		font-weight: 600;
		color: #fff;
		transition: all 0.3s ease;
		box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
		cursor: pointer;
		margin-left: 0.5rem; /* Add spacing between input and button */
	}

		.search-bar button[type="submit"]:hover {
			background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
			transform: translateY(-2px);
			box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
		}
</style>

<div class="container">
	<!-- Back button -->
	<a href="/" class="back-button">Върни се обратно</a>

	<h1 class="big-title">Потребители</h1>

	<!-- Search bar -->
	<div class="search-bar">
		<form asp-controller="Users" asp-action="List">
			<input type="text" id="searchInput" name="searchInput" placeholder="Търсене по име или имейл..." />
			<button type="submit" class="search-button">Търсене</button>
		</form>
	</div>

	<form method="post" action="@Url.Action("UpdateStatus", "Users")">
		<!-- Items per page selector -->
		<div class="form-group">
			<select id="itemsPerPage" class="form-select">
				<option value="4">4 за страница</option>
				<option value="6">6 за страница</option>
				<option value="8" selected>8 за страница</option>
			</select>
		</div>

		<!-- User table -->
		<table class="table">
			<thead>
				<tr>
					<th>Потребителско име</th>
					<th>Емейл</th>
					<th>Собствено име</th>
					<th>Бащино име</th>
					<th>Фамилно име</th>
					<th>Валидност</th>
					<th>Роля</th>
				</tr>
			</thead>
			<tbody id="userTableBody">
				@foreach (var user in Model)
				{
					<tr data-search="@($"{user.FirstName} {@user.MiddleName} {@user.LastName} {@user.Email}".ToLower())">
						<td>@user.UserName</td>
						<td>@user.Email</td>
						<td>@user.FirstName</td>
						<td>@user.MiddleName</td>
						<td>@user.LastName</td>
						<td>
							<input type="checkbox" name="isActive" checked="@user.IsActive" value="@user.Id" style="transform: scale(1.5); margin: auto;" />
						</td>
						<td>@string.Join(", ", user.Roles)</td>
					</tr>
				}
			</tbody>
		</table>

		<!-- Pagination -->
		<div class="form-group">
			<div id="pagination" class="pagination"></div>
		</div>

		<!-- Save button -->
		<div class="form-group">
			<button type="submit" class="btn btn-primary">Запази промените</button>
		</div>
	</form>
</div>

<script>
	document.addEventListener("DOMContentLoaded", function () {
		const searchInput = document.getElementById("searchInput");
		const itemsPerPageSelect = document.getElementById('itemsPerPage');
		const paginationContainer = document.getElementById('pagination');
		const tableRows = document.querySelectorAll("#userTableBody tr");

		let currentPage = 1;
		let itemsPerPage = parseInt(itemsPerPageSelect.value);
		let filteredRows = Array.from(tableRows);
		let totalFiltered = filteredRows.length;

		function updatePagination() {
			paginationContainer.innerHTML = '';

			const totalPages = Math.ceil(totalFiltered / itemsPerPage);

			// Create page buttons
			for (let i = 1; i <= totalPages; i++) {
				const pageButton = document.createElement('button');
				pageButton.textContent = i;
				pageButton.className = i === currentPage ? 'active' : '';
				pageButton.addEventListener('click', () => {
					currentPage = i;
					updatePage();
					updatePagination();
				});
				paginationContainer.appendChild(pageButton);
			}
		}

		function updatePage() {
			const start = (currentPage - 1) * itemsPerPage;
			const end = start + itemsPerPage;

			filteredRows.forEach(row => row.style.display = 'none');
			filteredRows.slice(start, end).forEach(row => row.style.display = '');
		}

		itemsPerPageSelect.addEventListener('change', (e) => {
			itemsPerPage = parseInt(e.target.value);
			currentPage = 1;
			updatePagination();
			updatePage();
		});

		// Initialize
		updatePagination();
		updatePage();
	});
</script>