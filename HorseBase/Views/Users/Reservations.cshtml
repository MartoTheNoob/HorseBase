@model List<Reservation>

<style>
    /* Consistent container styling */
    .container {
        background: rgb(230, 200, 160);
        border-radius: 15px;
        padding: 1.5rem;
        max-width: 1200px;
        margin: 2rem auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        max-height: 85vh; /* Enable vertical scrolling */
        overflow-y: auto; /* Add vertical scrollbar when needed */
        scrollbar-color: #8ea7e9 #f8f9fa; /* Custom scrollbar colors */
        scrollbar-width: thin; /* Thin scrollbar for modern browsers */
        position: relative;
        z-index: 2;
    }

        /* Scrollbar styling for Webkit browsers */
        .container::-webkit-scrollbar {
            width: 8px;
        }

        .container::-webkit-scrollbar-track {
            background: #f8f9fa;
            border-radius: 10px;
        }

        .container::-webkit-scrollbar-thumb {
            background: #8ea7e9;
            border-radius: 10px;
        }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }

    /* Table styling */
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.5rem;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        overflow: hidden;
    }

        .table th,
        .table td {
            padding: 0.8rem;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #343a40;
        }

        .table th {
            background: rgba(255, 255, 255, 0.2);
            font-weight: 600;
            color: #6c757d;
        }

        .table tr:nth-child(even) {
            background: rgba(255, 255, 255, 0.05);
        }

        .table tr:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* Checkbox styling */
        .table input[type="checkbox"] {
            transform: scale(1.2);
            cursor: pointer;
            accent-color: #8ea7e9;
        }

    /* Button styling */
    .btn-primary {
        background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
        width: 100%;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }
</style>

<div class="container">
    <h1 class="big-title">RESERVATIONS</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Number</th>
                <th>Breed</th>
                <th>Take Hour</th>
                <th>Return Hour</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Reservation item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Horse.Number)</td>
                    <td>@Html.DisplayFor(modelItem => item.Horse.Breed.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.TakeHour)</td>
                    <td>@Html.DisplayFor(modelItem => item.ReturnHour)</td>
                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                    <td>
                        <a asp-controller="Horse" asp-action="Details" asp-route-id="@item.Horse.Id" class="btn btn-primary">
                            Details for horse
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>