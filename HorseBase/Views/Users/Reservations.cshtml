@model List<Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<!-- Import Horse Index styles -->
<style>
    /* Base styles from Horse Index */
    body {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .container {
        background: rgb(230, 200, 160);
        border-radius: 15px;
        padding: 1.5rem;
        max-width: 1000px;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        max-height: 95vh;
        overflow-y: auto;
        position: relative;
        z-index: 2;
    }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }

    /* Table styling from Horse Index */
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

        .table th,
        .table td {
            padding: 0.8rem 1rem;
            text-align: center;
            border: none;
        }

        .table thead {
            background: rgba(255, 255, 255, 0.2);
            color: #343a40;
            font-weight: bold;
        }

        .table tbody tr {
            position: relative;
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }

            .table tbody tr:last-child {
                border-bottom: none;
            }

            .table tbody tr:hover {
                background: rgba(255, 255, 255, 0.1);
                border-color: rgba(142, 167, 233, 0.3);
            }

            .table tbody tr:nth-child(even) {
                background: rgba(255, 255, 255, 0.05);
            }

    /* Pagination styling */
    .pagination {
        display: flex;
        justify-content: center;
        margin-top: 1rem;
        gap: 0.5rem;
    }

        .pagination button {
            background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 15px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
            cursor: pointer;
        }

            .pagination button:hover {
                background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
            }

            .pagination button.active {
                background: linear-gradient(135deg, rgba(142, 167, 233, 1), rgba(187, 209, 253, 1));
                font-weight: bold;
            }

    /* Buttons styling */
    .btn-primary {
        background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 15px;
        font-weight: 600;
        color: #fff;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
        width: 100%;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }
</style>

<div class="container">
    <h1 class="big-title">РЕЗЕРВАЦИИ</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Номер</th>
                <th>Порода</th>
                <th>Дата и час на вземане</th>
                <th>Дата и час на връщане</th>
                <th>Цена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody id="reservationTableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Horse.Number</td>
                    <td>@item.Horse.Breed.Name</td>
                    <td>@item.TakeHour</td>
                    <td>@item.ReturnHour</td>
                    <td>@item.Price</td>
                    <td>
                        <a asp-controller="Horse" asp-action="Details" asp-route-id="@item.Horse.Id" class="btn btn-primary">
                            Детайли за коня
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Container -->
    <div class="pagination" id="pagination"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tableRows = document.querySelectorAll("#reservationTableBody tr");
        const paginationContainer = document.getElementById("pagination");
        let currentPage = 1;
        const itemsPerPage = 3; // 3 reservations per page

        function updatePagination() {
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(tableRows.length / itemsPerPage);

            // Create page buttons
            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.textContent = i;
                btn.className = i === currentPage ? 'active' : '';
                btn.addEventListener('click', () => {
                    currentPage = i;
                    updatePage();
                    updatePagination();
                });
                paginationContainer.appendChild(btn);
            }
        }

        function updatePage() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;

            // Hide all rows
            tableRows.forEach(row => row.style.display = 'none');

            // Show current page rows
            for (let i = start; i < end; i++) {
                if (tableRows[i]) tableRows[i].style.display = '';
            }
        }

        updatePagination();
        updatePage();
    });
</script>