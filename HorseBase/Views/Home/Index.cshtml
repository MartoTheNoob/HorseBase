@{
    ViewData["Title"] = "Начална страница";
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Начална страница</title>
    <style>
        /* Общ стил за тялото */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            position: relative; /* Гарантира, че абсолютното позициониране работи в рамките на body */
            min-height: 100vh;
            min-width: 100vw;
            background-color: transparent; /* Уверява, че не пречи на слоя отгоре */
        }

        /* Стил на логото */
        .logo {
            position: absolute;
            top: 10px;
            left: 10px;
            width: 150px; /* Регулира размера при нужда */
            z-index: 110; /* Уверява, че се появява над слоя отгоре */
        }

        /* Стил на големия бутон */
        .big-button {
            position: absolute;
            bottom: 20px; /* Разстояние отдолу */
            left: 50%; /* Центриране по хоризонтала */
            transform: translateX(-50%); /* Перфектно центриране на бутона */
            z-index: 110; /* Уверява, че се появява над слоя отгоре */
            background: linear-gradient(135deg, #f0f0f0, #e0e0e0); /* Лек градиент за модерен вид */
            color: #333; /* Тъмен текст за контраст */
            border: none;
            padding: 15px 30px; /* Отстояния за по-добро оформление */
            font-size: 16px; /* Размер на шрифта */
            border-radius: 8px; /* Закръглени ъгли */
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Леки сенки за дълбочина */
            height: 75px; /* Автоматична височина според съдържанието */
            width: 200px; /* Автоматична ширина според съдържанието */
            font-weight: bold;
            text-transform: uppercase; /* Главни букви */
            letter-spacing: 1px; /* Разстояние между буквите */
            transition: all 0.3s ease; /* Плавни преходи */
            outline: none; /* Премахване на стандартната контурна рамка */
        }

            /* Ефект при задържане - полупрозрачен фон */
            .big-button:hover {
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(240, 240, 240, 0.5)); /* Полупрозрачен градиент */
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15); /* Подсилена сянка за модерен ефект */
                color: #2c3e50; /* Леко по-тъмен текст за по-добър контраст */
            }

    </style>
</head>
<body>
    <!-- Лого -->
    <img src="/images/logo.png" alt="Лого" class="logo">

    <!-- Голям бутон -->
    @if (User.IsInRole("Admin") || User.IsInRole("User"))
    {
        <a asp-controller="Horse" asp-action="Index" class="button big-button">Разгледайте конете!</a>
    }
</body>
</html>
