@model HorseBase.Models.Horse

@{
    ViewData["Title"] = "Delete";
}

<style>
    /* Existing container styling */
    .container {
        background: rgba(230, 200, 160);
        border-radius: 15px;
        padding: 1.5rem;
        max-width: 600px;
        margin: 2rem auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        position: relative;
        z-index: 2;
    }

    .dl-horizontal {
        display: grid;
        gap: 1rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }

    /* Centered alert styling */
    .alert-danger {
        background: rgba(255, 82, 82, 0.2);
        border: 1px solid rgba(255, 82, 82, 0.3);
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 2rem;
    }

        .alert-danger h4 {
            color: #ff4444;
            margin-bottom: 0.5rem;
        }

        .alert-danger p {
            color: #ff4444;
            margin-bottom: 0;
        }

    /* Danger button styling */
    .btn-danger {
        background: linear-gradient(135deg, #ff7a7a, #ff5252);
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(255, 82, 82, 0.3);
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #ff5252, #ff3b3b);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(255, 82, 82, 0.4);
        }

    /* Styled cancel button */
    .btn-secondary {
        background: linear-gradient(135deg, #8ea7e9, #a8c0ff);
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
    }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #6d93d9, #87a9e6);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }

    /* Responsive image */
    .photo-preview {
        max-width: 300px;
        height: auto;
        border-radius: 8px;
        margin: 1rem auto;
        display: block;
    }
</style>

<div class="container">
    <h1 class="big-title">DELETE HORSE</h1>

    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">⚠️ Permanent Deletion</h4>
        <p>This action cannot be undone. All associated data including photos will be permanently removed.</p>
    </div>

    <dl class="dl-horizontal">
        <div>
            <dt>@Html.DisplayNameFor(model => model.Number)</dt>
            <dd>@Html.DisplayFor(model => model.Number)</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Breed.Name)</dt>
            <dd>@Html.DisplayFor(model => model.Breed.Name)</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.BirhtYear)</dt>
            <dd>@Html.DisplayFor(model => model.BirhtYear)</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Gender)</dt>
            <dd>@Html.DisplayFor(model => model.Gender)</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Height)</dt>
            <dd>@Html.DisplayFor(model => model.Height)</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.Price)</dt>
            <dd>@Html.DisplayFor(model => model.Price)$</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.PhotoPath)</dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    var imagePaths = Model.PhotoPath.Split(',');
                    <img src="@imagePaths.First()" class="photo-preview" />
                }
            </dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3">
            <input type="submit" value="Confirm Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>