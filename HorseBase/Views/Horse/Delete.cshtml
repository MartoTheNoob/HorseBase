@model HorseBase.Models.Horse

@{
    ViewData["Title"] = "Изтриване";
}

<style>
    /* Стилизиране на контейнера */
    .container {
        background: rgba(230, 200, 160);
        border-radius: 15px;
        padding: 1.5rem;
        max-width: 600px;
        margin: 2rem auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        max-height: 95vh; /* Enable vertical scrolling */
        overflow-y: auto; /* Add vertical scrollbar when needed */
        scrollbar-color: #8ea7e9 #f8f9fa; /* Custom scrollbar colors */
        scrollbar-width: thin; /* Thin scrollbar for modern browsers */
        position: relative;
        z-index: 2;
    }

        /* Scrollbar styling for Webkit browsers */
        .container::-webkit-scrollbar {
            width: 8px;
        }

        .container::-webkit-scrollbar-track {
            background: #f8f9fa;
            border-radius: 10px;
        }

        .container::-webkit-scrollbar-thumb {
            background: #8ea7e9;
            border-radius: 10px;
        }

    .dl-horizontal {
        display: grid;
        gap: 1rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }

    .alert-danger {
        background: rgba(255, 82, 82, 0.2);
        border: 1px solid rgba(255, 82, 82, 0.3);
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 2rem;
    }

        .alert-danger h4 {
            color: #ff4444;
            margin-bottom: 0.5rem;
        }

        .alert-danger p {
            color: #ff4444;
            margin-bottom: 0;
        }

    .btn-danger {
        background: linear-gradient(135deg, #ff7a7a, #ff5252);
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(255, 82, 82, 0.3);
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #ff5252, #ff3b3b);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(255, 82, 82, 0.4);
        }

    .btn-secondary {
        background: linear-gradient(135deg, #8ea7e9, #a8c0ff);
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
    }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #6d93d9, #87a9e6);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }

    .photo-preview {
        max-width: 300px;
        height: auto;
        border-radius: 8px;
        margin: 1rem auto;
        display: block;
    }
</style>

<div class="container">
    <h1 class="big-title">ИЗТРИВАНЕ</h1>

    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">⚠️ Перманентно изтриване</h4>
        <p>Това действие не може да бъде отменено. Всички свързани данни, включително снимки, ще бъдат безвъзвратно премахнати.</p>
    </div>

    <dl class="dl-horizontal">
        <div>
            <dt>Номер</dt>
            <dd>@Html.DisplayFor(model => model.Number)</dd>
        </div>
        <div>
            <dt>Порода</dt>
            <dd>@Html.DisplayFor(model => model.Breed.Name)</dd>
        </div>
        <div>
            <dt>Година на раждане</dt>
            <dd>@Html.DisplayFor(model => model.BirhtYear)</dd>
        </div>
        <div>
            <dt>Пол</dt>
            <dd>@Html.DisplayFor(model => model.Gender)</dd>
        </div>
        <div>
            <dt>Височина</dt>
            <dd>@Html.DisplayFor(model => model.Height)</dd>
        </div>
        <div>
            <dt>Цена за час</dt>
            <dd>@Html.DisplayFor(model => model.Price) лв.</dd>
        </div>
        <div>
            <dt>@Html.DisplayNameFor(model => model.PhotoPath)</dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    var imagePaths = Model.PhotoPath.Split(',');
                    <img src="@imagePaths.First()" class="photo-preview" />
                }
            </dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3">
            <input type="submit" value="Потвърди изтриването" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Отказ</a>
        </div>
    </form>
</div>
