@model HorseBase.Models.Horse

@{
    ViewData["Title"] = "Details";
}

<style>
    /* Centered container with vertical alignment */
    .container {
        background: rgba(230, 200, 160);
        border-radius: 15px;
        padding: 1.5rem;
        max-width: 600px;
        margin: 0 auto; /* Center horizontally */
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        max-height: 95vh; /* Enable vertical scrolling */
        overflow-y: auto;
        scrollbar-color: #8ea7e9 #f8f9fa;
        scrollbar-width: thin;
        position: relative;
        z-index: 2;
    }

        /* Scrollbar styling for Webkit browsers */
        .container::-webkit-scrollbar {
            width: 8px;
        }

        .container::-webkit-scrollbar-track {
            background: #f8f9fa;
            border-radius: 10px;
        }

        .container::-webkit-scrollbar-thumb {
            background: #8ea7e9;
            border-radius: 10px;
        }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }

    /* Definition list styling */
    .dl-details {
        display: grid;
        gap: 1rem;
        margin-bottom: 2rem;
        text-align: center;
    }

        .dl-details > div {
            padding: 1rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

    dt {
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0.5rem;
    }

    dd {
        margin: 0;
        color: #343a40;
        font-size: 1.1rem;
    }

    /* Button styling */
    .btn-primary {
        background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }

    .btn-secondary {
        background: linear-gradient(135deg, #8ea7e9, #a8c0ff);
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
    }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #6d93d9, #87a9e6);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }

    /* Centered button group */
    .button-group {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }

    /* Responsive image carousel */
    .photo-preview-container {
        position: relative;
        width:100%;
        max-width: 100%; /* Ensure it doesn't exceed the parent container */
        height: auto; /* Dynamically adjust height based on the image */
        margin: 1rem auto;
        overflow: hidden; /* Prevent images from overflowing */
    }

    /* Smooth transition for image changes */
    .photo-preview {
        width: 100%; /* Make the image responsive */
        height: auto; /* Maintain aspect ratio */
        max-height: 501.75px;
        border-radius: 8px;
        position: absolute; /* Stack images on top of each other */
        top: 0;
        left: 50%; /* Center the image horizontally */
        transform: translateX(-50%); /* Adjust for perfect centering */
        opacity: 0; /* Start with invisible images */
        transition: opacity 0.8s ease-in-out; /* Smooth fade effect */
        z-index: 1; /* Ensure images stack properly */
        display: none; /* Hide all images by default */
    }

        .photo-preview.active {
            opacity: 1; /* Fully visible */
            z-index: 2; /* Bring the active image to the front */
            display: block; /* Show only the active image */
        }

    /* Position indicators below the image */
    .photo-indicators {
        display: flex;
        justify-content: center;
        margin-top: 1rem; /* Space between image and indicators */
        gap: 0.5rem;
    }

    .photo-indicator {
        width: 10px;
        height: 10px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        cursor: pointer;
        transition: background 0.3s ease;
    }

        .photo-indicator.active {
            background: rgba(255, 255, 255, 1);
        }
</style>

<div class="container">
    <h1 class="big-title">Детайли</h1>

    <dl class="dl-details">
        <!-- Photo Preview -->
        <div>
            <dt>Снимки</dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    var imagePaths = Model.PhotoPath.Split(',');
                    <div class="photo-preview-container">
                        @foreach (var path in imagePaths)
                        {
                            <img src="@path.Trim()" class="photo-preview" />
                        }
                    </div>
                    <!-- Move indicators below the image -->
                    <div class="photo-indicators">
                        @for (int i = 0; i < imagePaths.Length; i++)
                        {
                            <div class="photo-indicator @(i == 0 ? "active" : "")" data-index="@i"></div>
                        }
                    </div>
                }
                else
                {
                    <!-- Default Image -->
                    <img src="/images/horse_profile.jpg" alt="Default Horse Image" style="width: 100%; height: auto; border-radius: 8px;" />
                }
            </dd>
        </div>
        <div>
            <dt>Номер</dt>
            <dd>@Html.DisplayFor(model => model.Number)</dd>
        </div>
        <div>
            <dt>Порода</dt>
            <dd>@Html.DisplayFor(model => model.Breed.Name)</dd>
        </div>
        <div>
            <dt>Година на раждане</dt>
            <dd>@Html.DisplayFor(model => model.BirhtYear)</dd>
        </div>
        <div>
            <dt>Пол</dt>
            <dd>@Html.DisplayFor(model => model.Gender)</dd>
        </div>
        <div>
            <dt>Височина</dt>
            <dd>@Html.DisplayFor(model => model.Height)</dd>
        </div>
        <div>
            <dt>Цена за час</dt>
            <dd>@Html.DisplayFor(model => model.Price) лв.</dd>
        </div>
    </dl>

    <div class="button-group">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактирай</a>
        }
        <a asp-action="Index" class="btn btn-secondary">Връщане в листа</a>
        <a asp-controller="Reservation" asp-action="Create" asp-route-horseId="@Model.Id" class="btn btn-primary">Резервирай</a>
    </div>
</div>

<script>
       document.addEventListener("DOMContentLoaded", function () {
        const imagePaths = "@Model.PhotoPath".split(',').map(path => path.trim());
        if (imagePaths.length <= 0) return; // Exit if no images exist

        const photos = document.querySelectorAll('.photo-preview');
        const indicators = document.querySelectorAll('.photo-indicator');
        let currentIndex = 0;

        function showImage(index) {
            // Hide all images
            photos.forEach(photo => photo.style.display = 'none');

            // Update the index
            currentIndex = index;

            // Show the new image
            const newPhoto = photos[currentIndex];
            newPhoto.style.display = 'block';
            newPhoto.classList.add('active');

            // Update indicators
            indicators.forEach((indicator, i) => {
                indicator.classList.toggle('active', i === currentIndex);
            });

            // Adjust the container height to match the active image
            const container = document.querySelector('.photo-preview-container');
            container.style.height = `${newPhoto.offsetHeight}px`;
        }

        function nextImage() {
            // Increment the index and loop back to 0 if at the end
            currentIndex = (currentIndex + 1) % imagePaths.length;
            showImage(currentIndex);
        }

        // Automatic image change every 5 seconds
        setInterval(nextImage, 7000);

        // Manual image change on indicator click
        indicators.forEach((indicator, index) => {
            indicator.addEventListener('click', () => {
                showImage(index);
            });
        });

        // Allow users to click on images to select them
        photos.forEach((photo, index) => {
            photo.addEventListener('click', () => {
                showImage(index);
            });
        });

        // Initialize the first image
        showImage(currentIndex);
    });
</script>