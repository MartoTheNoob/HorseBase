@model HorseBase.Models.Horse

@{
    ViewData["Title"] = "Create";
}

<style>
    /* Add this to your site.css or a new CSS file */
    .create-form {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 15px;
        padding: 1.5rem; /* Reduced padding for shorter page */
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        max-width: 500px;
        margin: 1rem auto; /* Reduced margin for shorter page */
    }

    .form-group {
        margin-bottom: 1rem; /* Reduced margin for shorter page */
    }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            text-align: center;
            font-size: 18px; /* Slightly reduced font size */
        }

    .form-control {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        padding: 0.6rem 1rem; /* Reduced padding for shorter page */
        color: #343a40;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2);
            outline: none;
        }

    .btn-primary {
        background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
        border: none;
        padding: 0.6rem 1.5rem; /* Reduced padding for shorter page */
        border-radius: 25px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
        font-weight: 600;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
            transform: translateY(-2px);
        }

    /* Radio button styling */
    .radio-container {
        display: flex;
        gap: 1rem; /* Adds spacing between radio buttons */
        justify-content: center; /* Centers the radio buttons */
        font-size: 14px; /* Sets font size for radio button labels */
    }

    .radio-container input[type="radio"] {
        margin-right: 0.2rem; /* Adds spacing between the radio button and its label */
    }

    /* Page background styling */
    body {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem; /* Space below the title */
        color: #343a40;
    }

    .container {
        background: rgba(230, 200, 160); /* Increased opacity for better contrast */
        border-radius: 15px;
        padding: 1.5rem; /* Reduced padding for shorter page */
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        width: 100%;
        margin: 1rem auto; /* Reduced margin for shorter page */
        position: relative;
        z-index: 2;
    }
</style>

<div class="container">
    <div class="row">
        <div>
            <h1 class="big-title">CREATE</h1>
            <!-- Form to submit data, enctype="multipart/form-data" to allow file uploads -->
            <form asp-action="Create" enctype="multipart/form-data" class="d-flex flex-column">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Number" class="control-label"></label>
                    <input asp-for="Number" class="form-control" />
                    <span asp-validation-for="Number" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BreedId" class="control-label"></label>
                    <select asp-for="BreedId" class="form-control" asp-items="ViewBag.BreedId"></select>
                </div>

                <div class="form-group">
                    <label asp-for="BirhtYear" class="control-label"></label>
                    <input asp-for="BirhtYear" class="form-control" />
                    <span asp-validation-for="BirhtYear" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="control-label">Пол</label>
                    <div class="radio-container">
                        <label>
                            <input type="radio" asp-for="Gender" value="Male" /> Мъжки
                        </label>
                        <label>
                            <input type="radio" asp-for="Gender" value="Female" /> Женски
                        </label>
                    </div>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Height" class="control-label"></label>
                    <input asp-for="Height" class="form-control" />
                    <span asp-validation-for="Height" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <!-- File input field for photos -->
                <div class="form-group">
                    <label asp-for="PhotoPath" class="control-label"></label>
                    <input type="file" name="photos" multiple class="form-control" />
                    <span asp-validation-for="PhotoPath" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary w-100 text-center" />
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-primary w-100">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}