	@model IEnumerable<HorseBase.Models.Horse>
	@{
		ViewData["Title"] = "Index";
	}
	<style>
		/* Add this to your site.css or a new CSS file */
		.create-form {
			background: rgba(255, 255, 255, 0.15);
			border-radius: 15px;
			padding: 1.5rem; /* Reduced padding for shorter page */
			backdrop-filter: blur(10px);
			border: 1px solid rgba(255, 255, 255, 0.2);
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
			max-width: 500px;
			margin: 1rem auto; /* Reduced margin for shorter page */
		}

		.big-title {
			font-size: 24px;
			font-weight: bold;
			text-align: center;
			margin-bottom: 1.5rem; /* Space below the title */
			color: #343a40;
		}

		.container {
			background: rgb(230, 200, 160);
			border-radius: 15px;
			padding: 1.5rem;
			max-width: 1000px;
			margin: 0 auto;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
			max-height: 95vh; /* Match viewport height */
			overflow-y: auto; /* Enable vertical scrolling */
			scrollbar-color: rgb(230, 200, 160) #f8f9fa;
			scrollbar-width: thin;
			position: relative;
			z-index: 2;
		}

	/* Search Bar */
	.filter-form input[type="text"] {
		background: rgba(255, 255, 255, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 8px;
		padding: 0.6rem 1rem;
		color: #343a40;
		transition: all 0.3s ease;
	}

	/* Block View Styling */
	.block-container {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
		margin-top: 1rem;
	}

	.block-item {
		background: rgba(255, 255, 255, 0.15);
		border-radius: 10px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
		width: calc(33% - 1rem); /* Adjust for 3 items per row */
		padding: 1rem;
		text-align: center;
		transition: transform 0.3s ease;
	}

		.block-item:hover {
			transform: scale(1.05);
		}

		.block-item img {
			width: 100%;
			height: auto;
			border-radius: 8px;
		}

		.block-item .number {
			font-size: 1.2rem;
			font-weight: bold;
			margin-top: 0.5rem;
		}

		.block-item .breed {
			font-size: 1rem;
			color: #555;
			margin-top: 0.5rem;
		}
		/* Filter Button */
		.filter-button {
			position: absolute;
			background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
			border: none;
			padding: 0.6rem 1rem;
			border-radius: 15px;
			font-weight: 600;
			transition: all 0.3s ease;
			box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
			cursor: pointer;
		}

			.filter-button:hover {
				background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
				transform: translateY(-2px);
				box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
			}
		/* Filter Menu */
		.filter-menu {
			position: fixed;
			top: 0;
			left: 0;
			width: 300px;
			height: 100%;
			background: rgba(230, 200, 160, 0.9);
			border-radius: 0 15px 15px 0;
			box-shadow: 4px 0 15px rgba(0, 0, 0, 0.1);
			backdrop-filter: blur(10px);
			z-index: 10;
			transform: translateX(-100%);
			transition: transform 0.3s ease-in-out;
			overflow-y: auto;
			padding: 1.5rem;
		}

			.filter-menu.active {
				transform: translateX(0);
			}
		/* Close Button */
		.close-button {
			position: absolute;
			top: 1rem;
			right: 1rem;
			background: none;
			border: none;
			font-size: 1.5rem;
			cursor: pointer;
			color: #343a40;
		}
		/* Filter Form */
		.filter-form {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

			.filter-form label {
				font-weight: 600;
				color: #343a40;
			}

			.filter-form select,
			.filter-form input {
				background: rgba(255, 255, 255, 0.2);
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: 8px;
				padding: 0.6rem 1rem;
				color: #343a40;
				transition: all 0.3s ease;
			}

				.filter-form input[type="range"] {
					height: 10px;
					background: rgba(255, 255, 255, 0.1);
					border-radius: 5px;
					outline: none;
				}

			.filter-form button {
				background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
				border: none;
				padding: 0.6rem 1rem;
				border-radius: 15px;
				font-weight: 600;
				transition: all 0.3s ease;
				box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
				cursor: pointer;
			}

				.filter-form button:hover {
					background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
					transform: translateY(-2px);
					box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
				}
		/* Table styling */
		.table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1rem;
			background: rgba(255, 255, 255, 0.15);
			border-radius: 10px;
			overflow: hidden;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
		}

			.table th,
			.table td {
				padding: 0.8rem 1rem;
				text-align: center;
				border: none;
			}

			.table tbody tr {
				position: relative;
				border-bottom: 1px solid rgba(0, 0, 0, 0.1);
				transition: all 0.3s ease;
			}

				.table tbody tr:last-child {
					border-bottom: none;
				}

				.table tbody tr:hover {
					background: rgba(255, 255, 255, 0.1);
					border-color: rgba(142, 167, 233, 0.3);
				}

			.table thead {
				background: rgba(255, 255, 255, 0.2);
				color: #343a40;
				font-weight: bold;
			}

			.table tbody tr:nth-child(even) {
				background: rgba(255, 255, 255, 0.05);
			}

			.table tbody tr:hover {
				background: rgba(255, 255, 255, 0.1);
			}

		.btn-primary {
			background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
			border: none;
			padding: 0.4rem 1rem; /* Reduced padding */
			border-radius: 15px; /* Smaller radius */
			font-size: 14px; /* Smaller text */
			margin: 0.2rem 0; /* Vertical spacing between buttons */
			transition: all 0.3s ease;
			box-shadow: 0 2px 5px rgba(142, 167, 233, 0.2);
			font-weight: 500;
			width: 100%; /* Full-width buttons */
		}

			.btn-primary:hover {
				background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
				transform: translateY(-1px);
				box-shadow: 0 3px 8px rgba(142, 167, 233, 0.3);
			}
		/* Page background styling */
		body {
			background: linear-gradient(135deg, #f8f9fa, #e9ecef);
			min-height: 100vh;
			font-family: 'Inter', sans-serif;
		}

	.pagination {
		display: flex;
		justify-content: center;
		margin-top: 1rem;
		gap: 0.5rem;
	}

		.pagination button {
			background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
			border: none;
			padding: 0.5rem 1rem;
			border-radius: 15px;
			font-weight: 600;
			transition: all 0.3s ease;
			box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
			cursor: pointer;
		}

			.pagination button:hover {
				background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
				transform: translateY(-2px);
				box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
			}

			.pagination button.active {
				background: linear-gradient(135deg, rgba(142, 167, 233, 1), rgba(187, 209, 253, 1));
				font-weight: bold;
			}

	</style>
<div class="container">
	<!-- Бутон за филтриране -->
	<button id="filterButton" class="filter-button top: 1rem;left: 1rem" ;>
		Филтър
	</button>
	<!-- Бутон за превключване на изгледа -->
	<button id="toggleViewButton" class="filter-button" style="position: absolute; top: 1rem; right: 1rem;">
		Блоков изглед
	</button>
	<h1 class="big-title">КОНЕ</h1>
	<p style="text-align: center;">
		@if (User.IsInRole("Admin"))
		{
			<a asp-action="Create" class="btn btn-primary">Създай нов</a>
		}
	</p>
	<!-- Изглед на списък -->
	<div id="listView">
		<table class="table">
			<thead>
				<tr>
					<th>Номер</th>
					<th>Порода</th>
					<th>Година на раждане</th>
					<th>Пол</th>
					<th>Височина</th>
					<th>Цена</th>
					<th>Снимка</th>
					<th>Действия</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>@Html.DisplayFor(modelItem => item.Number)</td>
						<td>@Html.DisplayFor(modelItem => item.Breed.Name)</td>
						<td>@Html.DisplayFor(modelItem => item.BirhtYear.Year)</td>
						<td>@Html.DisplayFor(modelItem => item.Gender)</td>
						<td>@Html.DisplayFor(modelItem => item.Height)</td>
						<td>@Html.DisplayFor(modelItem => item.Price)</td>
						<td>
							@if (!string.IsNullOrEmpty(item.PhotoPath))
							{
								var imagePaths = item.PhotoPath.Split(',');
								<img src="@imagePaths.First()" style="width: 100px; height: auto;" />
							}
							else
							{
								<img src="~/images/horse_profile.jpg" style="width: 100px; height: auto;" alt="Стандартна снимка на кон" />
							}
						</td>
						<td>
							@if (User.IsInRole("Admin"))
							{
								<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Редактирай</a>
								<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-primary">Изтрий</a>
							}
							<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Детайли</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<!-- Блоков изглед -->
	<div id="blockView" style="display: none;">
		<div id="paginationContainer" class="pagination"></div>
		<div id="blockContent" class="block-container"></div>
	</div>
</div>
<!-- Меню за филтриране -->
<div id="filterMenu" class="filter-menu">
	<button id="closeFilterButton" class="close-button">&times;</button>
	<h2 style="text-align: center; color: #343a40;">Опции за филтриране</h2>
	<form class="filter-form" id="filterForm">

		<label for="breedFilter">Порода</label>
		<select id="breedFilter" name="breedFilter">
			<option value="">Всички породи</option>
			@foreach (var breed in ViewBag.Breeds)
			{
				<option value="@breed.Value">@breed.Text</option>
			}
		</select>

		<label for="genderFilter">Пол</label>
		<select id="genderFilter" name="genderFilter">
			<option value="">Всички полове</option>
			<option value="Male">Мъжки</option>
			<option value="Female">Женски</option>
		</select>

		<!-- Обхват на годината на раждане -->
		<label for="birthYearMinFilter">Година на раждане (Мин)</label>
		<input type="range" id="birthYearMinFilter" name="birthYearMinFilter" min="1900" max="2023" value="1900" />
		<span id="birthYearMinValue">1900</span>

		<label for="birthYearMaxFilter">Година на раждане (Макс)</label>
		<input type="range" id="birthYearMaxFilter" name="birthYearMaxFilter" min="1900" max="2023" value="2023" />
		<span id="birthYearMaxValue">2023</span>

		<!-- Обхват на височината -->
		<label for="heightMinFilter">Височина (Мин)</label>
		<input type="range" id="heightMinFilter" name="heightMinFilter" min="100" max="200" value="100" />
		<span id="heightMinValue">100 см</span>

		<label for="heightMaxFilter">Височина (Макс)</label>
		<input type="range" id="heightMaxFilter" name="heightMaxFilter" min="100" max="200" value="200" />
		<span id="heightMaxValue">200 см</span>

		<!-- Обхват на цената -->
		<label for="priceMinFilter">Цена (Мин)</label>
		<input type="range" id="priceMinFilter" name="priceMinFilter" min="0" max="10000" value="0" />
		<span id="priceMinValue">$0</span>

		<label for="priceMaxFilter">Цена (Макс)</label>
		<input type="range" id="priceMaxFilter" name="priceMaxFilter" min="0" max="10000" value="10000" />
		<span id="priceMaxValue">$10000</span>

		<button type="button" id="applyFilters">Приложи филтрите</button>
	</form>
</div>

	<script>
	document.addEventListener("DOMContentLoaded", function () {
		// Global variables
		let currentPage = 1;
		const itemsPerPage = 5;
		let filteredHorsesCache = null;
		let isListView = true;

		// DOM Elements
		const filterButton = document.getElementById("filterButton");
		const closeFilterButton = document.getElementById("closeFilterButton");
		const filterMenu = document.getElementById("filterMenu");
		const listView = document.getElementById("listView");
		const blockView = document.getElementById("blockView");
		const toggleViewButton = document.getElementById("toggleViewButton");
		const applyFiltersButton = document.getElementById("applyFilters");

		// Extract horse data from Razor Model
		const horses = [
	@foreach (var item in Model)
	{
		<text>
					{
						id: "@item.Id",
					number: "@item.Number",
					breed: "@item.Breed.Name",
					birthYear: "@item.BirhtYear.Year",
					gender: "@item.Gender",
					height: "@item.Height",
					price: "@item.Price",
					photo: "@(string.IsNullOrEmpty(item.PhotoPath) ? "" : item.PhotoPath.Split(',')[0])"
					},
		</text>
	}
		];

		// Toggle filter menu visibility
		filterButton.addEventListener("click", () => {
			filterMenu.classList.toggle("active");
		});

		closeFilterButton.addEventListener("click", () => {
			filterMenu.classList.remove("active");
		});

		// Close filter menu when clicking outside
		document.addEventListener("click", (event) => {
			if (!filterMenu.contains(event.target) && !filterButton.contains(event.target)) {
				filterMenu.classList.remove("active");
			}
		});

		// Toggle between List View and Block View
		toggleViewButton.addEventListener("click", () => {
			if (isListView) {
				listView.style.display = "none";
				blockView.style.display = "block";
				toggleViewButton.textContent = "Листов изглед";
				const currentData = filteredHorsesCache || horses;
				loadBlockView(currentData);
			} else {
				listView.style.display = "block";
				blockView.style.display = "none";
				toggleViewButton.textContent = "Блоков изглед";
			}
			isListView = !isListView;
		});

		// Load Block View with Pagination
		function loadBlockView(filteredHorses) {
			const blockContent = document.getElementById("blockContent");
			const paginationContainer = document.getElementById("paginationContainer");

			// Clear existing content
			blockContent.innerHTML = "";
			paginationContainer.innerHTML = "";

			// Calculate total pages
			const totalPages = Math.ceil(filteredHorses.length / itemsPerPage);

			// Get current page's horses
			const startIndex = (currentPage - 1) * itemsPerPage;
			const endIndex = startIndex + itemsPerPage;
			const currentHorses = filteredHorses.slice(startIndex, endIndex);

			// Render current page's horses
			currentHorses.forEach((horse) => {
				const block = document.createElement("div");
				block.className = "block-item";
				block.innerHTML = `
					<a href="/Horse/Details/${horse.id}" style="text-decoration: none; color: inherit;">
						<img src="${horse.photo || '/images/horse_profile.jpg'}" alt="${horse.number}">
						<div class="number">${horse.number}</div>
						<div class="breed">${horse.breed}</div>
					</a>
				`;
				blockContent.appendChild(block);
			});

			// Render Pagination Buttons
			for (let i = 1; i <= totalPages; i++) {
				const pageButton = document.createElement("button");
				pageButton.textContent = i;
				pageButton.classList.add("pagination-button");

				if (i === currentPage) {
					pageButton.classList.add("active");
				}

				pageButton.addEventListener("click", () => {
					currentPage = i;
					loadBlockView(filteredHorses);
				});

				paginationContainer.appendChild(pageButton);
			}
		}

		// Apply Filters Logic
		applyFiltersButton.addEventListener("click", () => {
			currentPage = 1; // Reset to first page

			const searchFilter = document.getElementById("searchFilter").value.toLowerCase();
			const breedFilter = document.getElementById("breedFilter").value;
			const genderFilter = document.getElementById("genderFilter").value;
			const birthYearMin = parseInt(document.getElementById("birthYearMinFilter").value) || 0;
			const birthYearMax = parseInt(document.getElementById("birthYearMaxFilter").value) || Infinity;
			const heightMin = parseInt(document.getElementById("heightMinFilter").value) || 0;
			const heightMax = parseInt(document.getElementById("heightMaxFilter").value) || Infinity;
			const priceMin = parseInt(document.getElementById("priceMinFilter").value) || 0;
			const priceMax = parseInt(document.getElementById("priceMaxFilter").value) || Infinity;

			const filteredHorses = horses.filter(horse => {
				const birthYear = parseInt(horse.birthYear);
				const height = parseInt(horse.height);
				const price = parseInt(horse.price);

				return (
					(searchFilter === "" || horse.breed.toLowerCase().includes(searchFilter)) &&
					(breedFilter === "" || horse.breed === breedFilter) &&
					(genderFilter === "" || horse.gender === genderFilter) &&
					birthYear >= birthYearMin &&
					birthYear <= birthYearMax &&
					height >= heightMin &&
					height <= heightMax &&
					price >= priceMin &&
					price <= priceMax
				);
			});

			filteredHorsesCache = filteredHorses;

			if (isListView) {
				updateListView(filteredHorses);
			} else {
				loadBlockView(filteredHorses);
			}

			filterMenu.classList.remove("active");
		});

		// Update List View with filtered data
		function updateListView(filteredHorses) {
			const tableBody = listView.querySelector("tbody");
			tableBody.innerHTML = "";

			filteredHorses.forEach(horse => {
				const row = document.createElement("tr");
				const isAdmin = @User.IsInRole("Admin").ToString().ToLower();
				const actionsHtml = isAdmin
					? `
						<a href="/Horse/Edit/${horse.id}" class="btn btn-primary">Edit</a>
						<a href="/Horse/Delete/${horse.id}" class="btn btn-primary">Delete</a>
						<a href="/Horse/Details/${horse.id}" class="btn btn-primary">Details</a>
					`
					: `<a href="/Horse/Details/${horse.id}" class="btn btn-primary">Details</a>`;

				row.innerHTML = `
					<td>${horse.number}</td>
					<td>${horse.breed}</td>
					<td>${horse.birthYear}</td>
					<td>${horse.gender}</td>
					<td>${horse.height}</td>
					<td>$${horse.price}</td>
					<td><img src="${horse.photo || '/images/horse_profile.jpg'}" style="width: 100px; height: auto;" /></td>
					<td>${actionsHtml}</td>
				`;

				tableBody.appendChild(row);
			});
		}

		// Range input value displays
		document.getElementById("birthYearMinFilter").addEventListener("input", (e) => {
			document.getElementById("birthYearMinValue").textContent = e.target.value;
		});

		document.getElementById("birthYearMaxFilter").addEventListener("input", (e) => {
			document.getElementById("birthYearMaxValue").textContent = e.target.value;
		});

		document.getElementById("heightMinFilter").addEventListener("input", (e) => {
			document.getElementById("heightMinValue").textContent = `${e.target.value} cm`;
		});

		document.getElementById("heightMaxFilter").addEventListener("input", (e) => {
			document.getElementById("heightMaxValue").textContent = `${e.target.value} cm`;
		});

		document.getElementById("priceMinFilter").addEventListener("input", (e) => {
			document.getElementById("priceMinValue").textContent = `$${e.target.value}`;
		});

		document.getElementById("priceMaxFilter").addEventListener("input", (e) => {
			document.getElementById("priceMaxValue").textContent = `$${e.target.value}`;
		});
	});
	</script>