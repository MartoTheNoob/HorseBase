@model HorseBase.Models.Horse
@{
    ViewData["Title"] = "Редактиране";
    var existingPhotos = ViewBag.ExistingPhotos as List<string> ?? new List<string>();
}
<style>
    /* Консистентен стил за контейнера */
    .container {
        background: rgba(230, 200, 160);
        border-radius: 15px;
        padding: 1.5rem;
        max-width: 500px;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        max-height: 95vh; /* Разрешава вертикално скролиране */
        overflow-y: auto; /* Добавя вертикален скрол, ако е необходимо */
        scrollbar-color: #8ea7e9 #f8f9fa; /* Персонализирани цветове за скролера */
        scrollbar-width: thin; /* Тънък скролер за модерни браузъри */
        position: relative;
        z-index: 2;
    }
        /* Стил за скролера в Webkit браузъри */
        .container::-webkit-scrollbar {
            width: 8px;
        }

        .container::-webkit-scrollbar-track {
            background: #f8f9fa;
            border-radius: 10px;
        }

        .container::-webkit-scrollbar-thumb {
            background: #8ea7e9;
            border-radius: 10px;
        }

    .big-title {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }
    /* Стил за групите на формата */
    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            text-align: center;
            font-size: 18px;
            color: #343a40;
        }

    .form-control {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        padding: 0.6rem 1rem;
        color: #343a40;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2);
            outline: none;
        }
    /* Стил за радио бутони */
    .radio-container {
        display: flex;
        gap: 1rem;
        justify-content: center;
        font-size: 14px;
        color: #343a40;
    }

        .radio-container input[type="radio"] {
            margin-right: 0.5rem;
        }
    /* Основен стил за бутона */
    .btn-primary {
        background: linear-gradient(135deg, rgba(142, 167, 233, 0.8), rgba(187, 209, 253, 0.8));
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
        width: 100%;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(142, 167, 233, 0.9), rgba(187, 209, 253, 0.9));
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }
    /* Стил за втори бутон */
    .btn-secondary {
        background: linear-gradient(135deg, #8ea7e9, #a8c0ff);
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(142, 167, 233, 0.3);
        width: 100%;
    }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #6d93d9, #87a9e6);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(142, 167, 233, 0.4);
        }
</style>
<div class="container">
    <h1 class="big-title">РЕДАКТИРАЙ КОН</h1>
    <!-- Форма за изпращане на данни, enctype="multipart/form-data" за позволяване на качване на файлове -->
    <form asp-action="Edit" enctype="multipart/form-data" class="d-flex flex-column">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <!-- Поле за номер -->
        <div class="form-group">
            <label>Номер</label>
            <input asp-for="Number" class="form-control" />
            <span asp-validation-for="Number" class="text-danger"></span>
        </div>
        <!-- Поле за порода -->
        <div class="form-group">
            <label>Порода</label>
            <select asp-for="BreedId" class="form-control" asp-items="ViewBag.BreedId"></select>
            <span asp-validation-for="BreedId" class="text-danger"></span>
        </div>
        <!-- Поле за година на раждане -->
        <div class="form-group">
            <label>Година на раждане</label>
            <input asp-for="BirhtYear" class="form-control" />
            <span asp-validation-for="BirhtYear" class="text-danger"></span>
        </div>
        <!-- Поле за пол -->
        <div class="form-group">
            <label>Пол</label>
            <div class="radio-container">
                <label>
                    <input type="radio" asp-for="Gender" value="Мъжки" /> Мъжки
                </label>
                <label>
                    <input type="radio" asp-for="Gender" value="Женски" /> Женски
                </label>
            </div>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>
        <!-- Поле за височина -->
        <div class="form-group">
            <label>Височина</label>
            <input asp-for="Height" class="form-control" />
            <span asp-validation-for="Height" class="text-danger"></span>
        </div>
        <!-- Поле за цена -->
        <div class="form-group">
            <label>Цена за час</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <!-- Поле за качване на снимки -->
        <div class="form-group">
            <label asp-for="PhotoPath" class="control-label"></label>
            <input type="file" name="photos" multiple class="form-control" />
            <span asp-validation-for="PhotoPath" class="text-danger"></span>
        </div>
        <!-- Бутон за изпращане -->
        <div class="form-group">
            <input type="submit" value="Запази" class="btn btn-primary" />
        </div>
    </form>
    <!-- Бутон за връщане в списъка -->
    <div style="text-align: center; margin-top: 1rem;">
        <a asp-action="Index" class="btn btn-secondary">Върни се в списъка</a>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
